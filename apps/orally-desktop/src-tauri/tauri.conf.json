{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orally",
  "version": "0.1.0",
  "identifier": "dev.orally.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orally Settings",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true
      },
      {
        "label": "dictation",
        "title": "Orally Dictation",
        "url": "overlay.html",
        "width": 380,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
